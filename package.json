    "web/pdfsignclient.js",
    "web/demo.html",
    "web/demo-custom.html",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "web/pdfsignclient.js"
  ],
  "keywords": [
    "pdf",
    "digital-signature",
    "usb-token",
    "smartcard",
    "pkcs7",
    "cms",
    "pades",
    "chu-ky-so",
    "epass2003",
    "safenet",
    "yubikey",
    "vnpt-ca",
    "viettel-ca"
  ],
  "homepage": "https://github.com/haoquangviet/hSignerBridge#readme",
