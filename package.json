{
  "name": "hsignerbridge",
  "version": "1.1.0",
  "description": "Client-side PDF digital signing in the browser with a USB token (ePass2003, SafeNet, VNPT-CA, Viettel-CA, YubiKey) — JS plugin + local signing bridge for Windows",
